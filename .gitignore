# Settings and secrets: never commit them
.env
.env.*
!.env-example
*.pem
*.key
# Local Compose overrides (published ports, local images)
docker-compose.override.yml
compose.override.yml

# Python bytecode
__pycache__/
*.pyc

# Runtime data written next to docker-compose.yml (bind mounts)
# Flowise: database encryption key, session secrets, uploads
/flowise_data/
# Langflow data from older lab versions (now in the langflow Docker volume)
/langflow/
# Files exchanged with the MCP servers and the evals reports
/n8n/shared/
/n8n/custom-nodes/
# Credential exports with real secrets (the committed templates are credentials_public/)
/n8n/backup/credentials/
mcp-servers-source/

# Docker volumes / local storage copied out of Docker
n8n_storage/
postgres_storage/
ollama_storage/
qdrant_storage/
open-webui/

# Backups (scripts/backup-volumes.sh)
backups/
*.tar.gz
*.tgz
*.tar.gz.enc

# OS and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*.tmp
*.bak
*~

# Check Point AI agent lab: settings file
#
# Give your keys ONCE, in one of three ways:
#   1. Guided setup (recommended): ./setup.sh
#      It asks for your model provider and Check Point keys (typed keys are hidden),
#      generates every lab secret, writes .env (readable only by you) and checks it.
#   2. Edit by hand: cp .env-example .env, fill in the keys you have, then run
#      ./setup.sh --non-interactive to generate the lab secrets that are still blank.
#   3. 1Password: ./setup.sh --1password writes op://vault/item/field references
#      instead of key values. Start the lab through 1Password:
#        op run --env-file=.env -- docker compose up -d
#
# Start the lab:   docker compose up -d   (the lab components that COMPOSE_PROFILES in section 6 sets)
# Check it:        ./scripts/doctor.sh --preflight     (before the first start)
#                  ./scripts/doctor.sh --post-start    (5 to 10 minutes after)
# After a change:  docker compose up -d   (recreates only what changed)
#
# Format: one NAME=value per line, no spaces around "=", no quotes needed.
# A blank value means "not set". Never commit .env or share it.

# ============================================================================
# 1. Required: lab admin and internal secrets (./setup.sh generates them)
# ============================================================================
# Leave the blank secrets to ./setup.sh. After the first start, do not change
# POSTGRES_PASSWORD, N8N_ENCRYPTION_KEY, SALT or LANGFUSE_ENCRYPTION_KEY: the
# databases keep the values they started with.

# Lab admin: one sign-in for n8n, Flowise, Langflow, Langfuse and Open WebUI.
N8N_ADMIN_EMAIL=admin@lab.local
# 8 to 64 characters, with an uppercase letter, a lowercase letter, a digit and
# one of - _ . ! @ %  (n8n and Flowise reject weaker passwords). Generated by ./setup.sh.
N8N_ADMIN_PASSWORD=
N8N_ADMIN_FIRST_NAME=Lab
N8N_ADMIN_LAST_NAME=Admin
# Open WebUI admin. Blank = the lab admin above.
OPEN_WEBUI_ADMIN_EMAIL=
OPEN_WEBUI_ADMIN_PASSWORD=

# Postgres, shared by n8n, Flowise and Langfuse. Keep the user and database names.
POSTGRES_USER=admin
POSTGRES_DB=n8n
# Generated by ./setup.sh. If you set your own, use only letters, digits and . _ ~ - (it is part
# of a database URL; ./scripts/doctor.sh rejects anything else).
POSTGRES_PASSWORD=

# n8n: encrypts the credentials stored in n8n. Generated by ./setup.sh.
N8N_ENCRYPTION_KEY=
# n8n: signs sign-in sessions. Generated by ./setup.sh.
N8N_USER_MANAGEMENT_JWT_SECRET=

# MCP gateway: the Bearer token every agent sends to http://mcp-gateway:8080/mcp.
# Generated by ./setup.sh. Safe to change later: the importers re-sync it on start.
MCP_GATEWAY_TOKEN=

# Langfuse tracing. Generated by ./setup.sh.
NEXTAUTH_SECRET=
SALT=
# 64 hex characters.
LANGFUSE_ENCRYPTION_KEY=
# Project key pair (pk-lf-... / sk-lf-...). Langfuse creates its project with them on first start.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Open WebUI: signs sign-in sessions, so recreating the container does not sign
# everyone out. Generated by ./setup.sh.
WEBUI_SECRET_KEY=

# LITELLM_MASTER_KEY, also required, is in the next section.

# ============================================================================
# 2. Lab model: the one model every agent uses
# ============================================================================
# ---------------- Lab model: LiteLLM, model name "lab-chat" ----------------
# Every agent in n8n, Flowise and Langflow uses ONE model, "lab-chat". Give ONE provider key
# below. auto (default) uses the first provider that is fully set: Azure OpenAI, OpenAI,
# Anthropic, Gemini. With no key at all it uses the local Ollama model (slow on a CPU).
# To force one: azure | openai | anthropic | gemini | ollama. LiteLLM then refuses to start,
# naming the missing variable, if that provider is not set. After any change here run:
#   docker compose up -d litellm
LAB_MODEL_PROVIDER=auto
# Required. The key every agent uses to call lab-chat. ./setup.sh generates it.
LITELLM_MASTER_KEY=
# Azure OpenAI: key, endpoint AND deployment are all needed.
AZURE_OPENAI_API_KEY=
# Resource URL from the Azure portal, e.g. https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
# Your deployment NAME (not the model name). Tip: name it after the model, e.g. gpt-5.1.
AZURE_OPENAI_DEPLOYMENT=
# Optional. The default 2024-10-21 (dated GA API) works with Azure OpenAI resources and with
# API Management gateways. Set v1 only if your endpoint accepts a Bearer token on /openai/v1.
# AZURE_OPENAI_API_VERSION=2024-10-21
# Reasoning for GPT-5 models: auto (default) turns reasoning off for tool calls, which keeps every
# agent on Chat Completions (works with any gateway). If your Azure deployment name does not start
# with gpt-5, set none. Other levels (minimal, low, medium, high) need an endpoint that serves the
# Responses API (and AZURE_OPENAI_API_VERSION=v1).
# LAB_REASONING_EFFORT=auto
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.1
# Optional: proxy or OpenAI-compatible server, base URL with its path (usually ends in /v1)
# OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# Google AI Studio key
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Local Ollama (used when no cloud key is set). Needs OLLAMA_MEM_LIMIT=6g (section 6).
# Local models need Docker with 16 GB of memory and run slowly on a CPU.
# OLLAMA_CHAT_MODEL=qwen3.5:4b
# OLLAMA_API_BASE=http://ollama-cpu:11434
# Context window in tokens. 32768 covers the largest agent (Fleet Commander sends ~18k tokens
# of tool descriptions). With Docker at 8 GB of memory you can lower it to 16384.
# OLLAMA_NUM_CTX=32768
# Thinking makes local answers much slower: false (default) | true | auto (model default)
# OLLAMA_THINK=false
# Optional, default http://langfuse:3000
# LANGFUSE_HOST=

# ============================================================================
# 3. Check Point products (each one optional)
# ============================================================================
# The lab starts without these. An agent whose product is not set answers that
# it is not configured. After a change here: docker compose up -d

# ---- Management server (on premises, or Smart-1 Cloud) ----
# Used by the Management, Management Logs, Threat Prevention, HTTPS Inspection,
# Policy Insights, Gateway CLI and Connection Analysis MCP servers.
# Set ONE of MANAGEMENT_HOST (on premises) or S1C_URL (Smart-1 Cloud), and a way to sign in.
# A host or URL without a way to sign in is ignored: the servers start without management access.
#
# On premises (Security Management Server or Multi-Domain Server): host name or IP address
# only (no https://), reachable FROM THIS DOCKER HOST. For a CloudShare lab use the
# server's public IP, not its 10.1.1.x lab address.
MANAGEMENT_HOST=
# Management API port of the on-premises server.
MANAGEMENT_PORT=443
# Smart-1 Cloud: the Web API URL of your tenant, without /login (Smart-1 Cloud portal:
# Settings > API & SmartConsole), for example https://<tenant>.maas.checkpoint.com/<id>/web_api
# Leave MANAGEMENT_HOST blank: when both are set, the servers use MANAGEMENT_HOST.
S1C_URL=
# Sign in with an API key. On premises: SmartConsole > Manage & Settings > Permissions &
# Administrators > Administrators > Authentication Method: API Key. Smart-1 Cloud: Settings >
# API & SmartConsole. Smart-1 Cloud accepts an API key only.
MANAGEMENT_API_KEY=
# Or, on premises only: user name and password of a management administrator. Set both or
# neither. When an API key is set too, the servers use the API key.
MANAGEMENT_USERNAME=
MANAGEMENT_PASSWORD=
# Certificate check (always on). If the management server uses a self-signed certificate,
# save it as certs/<name>.pem (see certs/README.md) and set the path inside the container.
# MANAGEMENT_CA_CERT=/certs/sms.pem
# When you connect by IP address and the certificate names a host, set that host name here.
# MANAGEMENT_TLS_SERVERNAME=

# ---- Gaia (the Gaia REST API of one Security Gateway, not the management server) ----
# Used by the Gaia MCP server. Leave blank to keep the Gaia tools inert.
GAIA_GATEWAY_IP=
GAIA_GATEWAY_PORT=443
GAIA_USERNAME=
GAIA_PASSWORD=
# The Gaia credentials are sent only to GAIA_GATEWAY_IP. To allow more gateways, list them
# here, comma-separated.
# GAIA_ALLOWED_GATEWAYS=
# Self-signed gateway certificate (certs/README.md) and the name to check when using an IP.
# GAIA_CA_CERT=/certs/gateway.pem
# GAIA_TLS_SERVERNAME=

# ---- Check Point portal and cloud services ----
# Create API keys in the Check Point portal (portal.checkpoint.com): Global Settings > API Keys > New.
# Documentation MCP server (Client ID + Secret Key of a Check Point portal API key).
DOC_CLIENT_ID=
DOC_SECRET_KEY=
# Region of your Check Point portal account: EU or US (uppercase).
DOC_REGION=EU
# Threat Emulation MCP server: Threat Prevention API key (Threat Emulation service).
TE_API_KEY=
# Reputation Service MCP server: Reputation Service API key.
REPUTATION_API_KEY=
# Spark Management MCP server (Check Point portal API key for Spark Management).
# The server stops with a "not configured" message while these are blank.
SPARK_MGMT_CLIENT_ID=
SPARK_MGMT_SECRET_KEY=
SPARK_MGMT_REGION=US
SPARK_MGMT_INFINITY_PORTAL_URL=https://cloudinfra-gw-us.portal.checkpoint.com/auth/external
# SASE MCP server (SASE administrator portal: Settings > API support). It needs all three
# settings and stops with a "not configured" message while one is blank.
HARMONY_SASE_API_KEY=
# Management API URL of your tenant, for example https://api.<management-host>/api
HARMONY_SASE_MANAGEMENT_HOST=
# Origin domain of your tenant, for example https://<tenant-origin-domain>
HARMONY_SASE_ORIGIN=
# Build Your Own MCP exercise (profile "exercises"): Check Point portal API key for
# the IPS service. See docs/guides/Build_Your_Own_MCP_Exercise.md.
IPS_CLIENT_ID=
IPS_ACCESS_KEY=
# Check Point portal region for the IPS API: EU (default) or US.
# IPS_REGION=EU
# Build Your Own MCP: solution (default) or scaffold (the unfinished exercise).
# IPS_CVE_VARIANT=solution
# Optional URL overrides. Blank = the default host. Set both for the same region:
# EU is https://cloudinfra-gw.portal.checkpoint.com, US is https://cloudinfra-gw-us.portal.checkpoint.com
IPS_AUTH_URL=
IPS_SERVICE_URL=
# Optional: MCP clients must then send "Authorization: Bearer <token>" to ips-cve-mcp. Blank = no
# token. Leave it blank while the MCP Gateway fronts the server (its catalog entry sends none).
# IPS_MCP_BEARER_TOKEN=

# ============================================================================
# 4. Optional integrations
# ============================================================================
# Lakera Guard (platform.lakera.ai): screens prompts and answers in the
# "Guarded Agent (Lakera Guard)" and "Lakera Guard Screening Agent" agents.
# Without a key those agents block every message and explain how to set it.
LAKERA_API_KEY=
# Optional: a Lakera project ID, so Guard applies that project's policy.
# Blank = Lakera's default policy.
LAKERA_PROJECT_ID=
# Bearer token the "Identity Provisioning Agent (SCIM)" sends to the identity
# provider at https://idp.<DOMAIN>/scim/v2 (needs DOMAIN, section 5).
IDP_SCIM_TOKEN=
# DevHub Operations Agent: API key of the DevHub MCP endpoint (https://hub.<DOMAIN>/api/mcp).
DEVHUB_MCP_TOKEN=
# PolicyPilot agents: MCP key of PolicyPilot (https://policypilot.<DOMAIN>/mcp).
# The optional PolicyPilot sidecar (profile "policypilot") also uses the settings after it.
# See docs/guides/PolicyPilot_Gateway_Sidecar_Guide.md.
PILOT_MCP_TOKEN=
POLICYPILOT_IMAGE=policypilot:custom
# Must match the key the PolicyPilot portal used to encrypt its saved credentials.
PILOT_ENCRYPTION_KEY=
# Generated by ./setup.sh. The sidecar derives its encryption key from it only while
# PILOT_ENCRYPTION_KEY is blank: if your portal has no PILOT_ENCRYPTION_KEY, put the
# portal's PILOT_SESSION_SECRET here instead.
PILOT_SESSION_SECRET=
PILOT_DATABASE_URL=sqlite:////data/policypilot.db
# Qdrant (the RAG vector database). Blank = no authentication on the internal lab network.
# Set a key to turn authentication on: Qdrant then requires it, and every lab client
# (rag-ingest and the RAG agents) sends it. After a change: docker compose up -d
QDRANT_API_KEY=
# Visible RAG: the seeded RAG agents use document chunks that score at least 0.5 (0 to 1).
# To check how your questions score, run:
#   docker compose run --rm rag-ingest python3 ingest.py --search "your question"
# RAG_MIN_SCORE sets the threshold that this --search probe reports against. To change the agents'
# threshold, edit RAG_MIN_SCORE in scripts/flows/langflow_fix.py and regenerate the flows.
# RAG_MIN_SCORE=0.5

# ============================================================================
# 5. Lab host (leave the defaults on your own computer)
# ============================================================================
# Domain of a shared lab host behind a reverse proxy, for example lab.example.com:
# the apps are then at n8n.<DOMAIN>, flowise.<DOMAIN>, langflow.<DOMAIN>,
# trace.<DOMAIN> (Langfuse) and chat.<DOMAIN> (Open WebUI). Blank on your own computer.
DOMAIN=
# n8n host name and public URLs. On a lab host: n8n.<DOMAIN> and https://n8n.<DOMAIN>/
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
# Address you open Langfuse at (its sign-in redirects go there). Blank = https://trace.<DOMAIN>.
# On your own computer, with Langfuse on a local port: http://localhost:3100
LANGFUSE_URL=
# Port Flowise listens on inside the lab network (the lab host's reverse proxy uses 3020).
FLOWISE_PORT=3020

# ============================================================================
# 6. Advanced (the defaults suit most labs)
# ============================================================================
# Lab components plus optional parts: profile names, comma-separated. ./setup.sh shows the CPUs
# and memory Docker can use, recommends the lab components, and sets this value.
#   (blank)       Standard lab: n8n and Flowise agent builders, the MCP Gateway and all Check Point
#                 MCP servers, lab-chat model access, Langfuse tracing and RAG.
#                 Requires Docker with 4 CPUs and 8 GB of memory.
#   complete      Complete lab: everything in the Standard lab, plus the Langflow agent builder
#                 and Open WebUI with local models. Requires Docker with 6 CPUs and 16 GB of memory.
#                 Lab hosts use complete (on Dokploy, set it in the project's environment settings).
#                 Formerly named "full": ./setup.sh renames it.
#   langflow      Langflow only (the heaviest builder, up to 2.5 GiB of memory)
#   local-chat    Open WebUI with a local Ollama chat model (needs OLLAMA_MEM_LIMIT=6g)
#   local-models  pulls the OLLAMA_MODELS chat models even when a cloud model key is set
#   evals         the agent evals: docker compose run --rm evals-run
#   ai-red-team   the AI-Infra-Guard scanner and its UI proxy aig-ui (no sign-in, so local access only)
#   exercises     the Build Your Own MCP exercise server
#   security-lab  the MCP Security Lab: an intentionally vulnerable server on its own network
#   policypilot   the PolicyPilot MCP sidecar (needs a PolicyPilot image and its data)
#   gpu-nvidia    Ollama on an NVIDIA GPU (NVIDIA hosts only)
# Example: COMPOSE_PROFILES=complete,exercises,security-lab
COMPOSE_PROFILES=
# Build of the lab image (n8n and the Check Point MCP servers): latest, or a commit id
# to pin one build. ./update.sh pulls a newer build.
LAB_IMAGE_TAG=latest
# Re-import: agents you changed in Flowise or Langflow are kept. Set to 1 for one
# run to replace them with the repository version, then set it back to 0.
SEED_OVERWRITE=0
# The same for n8n workflows (or: docker compose run --rm -e N8N_SEED_OVERWRITE=1 n8n-import).
N8N_SEED_OVERWRITE=0
# 1 = publish the "Nightly Agent Self-Check" workflow, which probes the agents every night.
NIGHTLY_SELF_QA=0
# Time zone for n8n schedules, for example Europe/Berlin or America/New_York.
GENERIC_TIMEZONE=UTC
# Local models. The default lab pulls only nomic-embed-text (the RAG embedder), plus
# OLLAMA_CHAT_MODEL when lab-chat runs on Ollama. OLLAMA_MODELS is what the complete, local-chat
# and local-models profiles pull (comma-separated). Larger models (for example qwen3.5:9b)
# need a GPU or much more memory.
OLLAMA_MODELS=qwen3.5:4b,nomic-embed-text
# How long an idle model stays in memory (for example 10m, 1h; -1 = forever).
OLLAMA_KEEP_ALIVE=10m
# At most this many models in memory at once.
OLLAMA_MAX_LOADED_MODELS=2
# Memory cap of the Ollama container. 1g holds the RAG embedding model only. A local chat
# model (lab-chat on Ollama, or Open WebUI in the Complete lab) needs 6g: ./setup.sh sets it
# then. Local models need Docker with 16 GB of memory and run slowly on a CPU.
OLLAMA_MEM_LIMIT=1g
# CPUs the Ollama container may use.
OLLAMA_CPUS=2
# Default model for new chats in Open WebUI (must be in OLLAMA_MODELS).
OPEN_WEBUI_DEFAULT_MODELS=qwen3.5:4b
# true = Langflow without sign-in. Keep false whenever the lab is reachable by others.
LANGFLOW_AUTO_LOGIN=false
# Optional API keys the importers use instead of the lab admin sign-in.
FLOWISE_API_KEY=
LANGFLOW_API_KEY=
# Blank = Langfuse uses the lab Postgres. Set a postgresql:// URL only for another server.
LANGFUSE_DATABASE_URL=
# Langfuse organization ID, used when Langfuse first starts (Langfuse never renames an organization).
# ./setup.sh keeps cp-playground, the former ID, for a lab that ran before this setting existed.
LANGFUSE_ORG_ID=check-point-agentic-lab
LANGFUSE_TELEMETRY_ENABLED=false
N8N_PUSH_BACKEND=websocket
CPINFO_LOG_LEVEL=info
# Evals (profile "evals"): target of the eval run. Default http://n8n:5678.
# EVALS_BASE_URL=
# AI-Infra-Guard (profile "ai-red-team"). Default model: lab-chat through LiteLLM.
# AIG_LLM_MODEL=lab-chat
# AIG_LLM_BASE_URL=http://litellm:4000/v1
# AIG_LLM_API_KEY=
# Language of scan reports: en (default) or zh.
# AIG_SCAN_LANGUAGE=en
